{
  "id": "dsh",
  "displayName": "DeepSeek Harness",
  "deployMode": "dsh-yaml-patch",
  "systemLauncher": {
    "command": "dsh",
    "packageNames": ["@deepseek-ai/dsh"],
    "argument": "--patch",
    "assetPath": "$PILOT_DATA/system-launchers/dsh/pilot.patch.yml",
    "assetFiles": ["dsh/plugin.mjs", "shared/resource-context.mjs"]
  },
  "detection": {
    "paths": ["$DSH_HOME"],
    "commands": ["dsh"]
  },
  "dshYamlPatch": {
    "pluginSource": "$PILOT_DATA/plugins/dsh/plugin.mjs",
    "entryId": "loongsuite-pilot-observability",
    "marker": "PILOT-OBSERVABILITY-MANAGED"
  },
  "input": {
    "type": "session-file-polling",
    "logDir": "$PILOT_DATA/logs/dsh",
    "filePattern": "dsh-*.jsonl"
  }
}
