{
  "id": "qwen-work-cn",
  "displayName": "QwenWorkCN",
  "deployMode": "hook",
  "detection": {
    "paths": ["~/.qwenworkcn"],
    "commands": []
  },
  "hook": {
    "settingsPath": "~/.qwenworkcn/settings.json",
    "events": ["Stop", "UserPromptSubmit"],
    "hookCommand": "$PILOT_DATA/hooks/qwenworkcn-loongsuite-pilot-hook.sh",
    "nativeSdkData": "state/standalone-qwen-work-cn-sdk",
    "format": "nested",
    "matcher": "*",
    "winShell": "powershell",
    "interceptor": {
      "events": ["UserPromptSubmit", "PreToolUse", "PostToolUse"],
      "hookCommand": "$PILOT_DATA/hooks/interceptor-qwenworkcn-hook.sh",
      "matcher": "*",
      "timeout": {
        "UserPromptSubmit": 15,
        "PreToolUse": 10,
        "PostToolUse": 10
      },
      "insert": "head"
    }
  },
  "input": {
    "type": "hook-jsonl",
    "logDir": "$PILOT_DATA/logs/qwen-work-cn/history"
  }
}
