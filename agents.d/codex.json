{
  "id": "codex",
  "displayName": "Codex",
  "deployMode": "hook",
  "detection": {
    "paths": ["$CODEX_HOME"],
    "commands": []
  },
  "hook": {
    "settingsPath": "$CODEX_HOME/hooks.json",
    "systemSettingsPath": "/etc/codex/config.toml",
    "events": ["SessionStart", "UserPromptSubmit", "SubagentStart", "SubagentStop", "Stop", "PreToolUse", "PostToolUse"],
    "retiredEvents": ["PostToolUseFailure"],
    "hookCommand": "$PILOT_DATA/hooks/codex-loongsuite-pilot-hook.sh",
    "format": "nested",
    "matcher": "*",
    "eventSubcommand": "kebab-case",
    "trustToml": {
      "configPath": "$CODEX_HOME/config.toml",
      "trustAlgo": "v1",
      "marker": "otel-codex-hook"
    }
  },
  "input": {
    "type": "session-file-polling"
  }
}
