{
  "id": "qoder",
  "displayName": "Qoder",
  "deployMode": "hook",
  "detection": {
    "paths": ["~/.qoder"],
    "commands": ["qoder"]
  },
  "hook": {
    "settingsPath": "~/.qoder/settings.json",
    "events": ["Stop"],
    "hookCommand": "$PILOT_DATA/hooks/qoder-loongsuite-pilot-hook.sh",
    "format": "nested",
    "matcher": "*",
    "winShell": "powershell",
    "replaceHookCommands": ["$PILOT_DATA/hooks/qoder-loongsuite-pilot-hook.sh qoder-cli", "$PILOT_DATA/hooks/qoder-loongsuite-pilot-hook.sh qoder"],
    "interceptor": {
      "events": ["UserPromptSubmit", "PreToolUse", "PostToolUse"],
      "hookCommand": "$PILOT_DATA/hooks/interceptor-hook.sh",
      "matcher": "*",
      "timeout": {
        "UserPromptSubmit": 15,
        "PreToolUse": 10,
        "PostToolUse": 10
      },
      "insert": "head"
    }
  },
  "input": {
    "type": "hook-jsonl",
    "logDir": "$PILOT_DATA/logs/qoder/history"
  }
}
