{
  "id": "workbuddy",
  "displayName": "WorkBuddy",
  "deployMode": "hook",
  "detection": {
    "paths": ["~/.workbuddy"],
    "commands": []
  },
  "hook": {
    "settingsPath": "~/.workbuddy/settings.json",
    "events": [
      "SessionStart",
      "UserPromptSubmit",
      "PreToolUse",
      "PostToolUse",
      "Stop"
    ],
    "hookCommand": "$PILOT_DATA/hooks/workbuddy-loongsuite-pilot-hook.sh",
    "format": "nested",
    "eventSubcommand": "kebab-case",
    "eventMatchers": {
      "PreToolUse": ".*",
      "PostToolUse": ".*"
    },
    "interceptor": {
      "events": ["UserPromptSubmit", "PreToolUse", "PostToolUse"],
      "hookCommand": "$PILOT_DATA/hooks/interceptor-hook.sh --agent workbuddy --event",
      "eventMatchers": {
        "PreToolUse": ".*",
        "PostToolUse": ".*"
      },
      "insert": "head"
    }
  },
  "input": {
    "type": "workbuddy-transcript",
    "eventDir": "$PILOT_DATA/state/workbuddy/hook-events"
  }
}
