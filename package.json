{
  "name": "ai-agent-collector",
  "version": "1.0.0",
  "type": "module",
  "description": "Multi-agent AI coding data collection platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "ai-agent-collector": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "perf:cursor-hook": "node tests/performance/cursor-hook-processor.perf.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "postinstall": "node scripts/postinstall.js"
  },
  "dependencies": {
    "@alicloud/log": "^1.2.6",
    "axios": "^1.6.0",
    "express": "^4.18.0",
    "sqlite3": "^6.0.1",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^18.0.0",
    "@types/uuid": "^9.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "typescript": "^5.3.0",
    "vitest": "^1.6.1"
  },
  "files": [
    "dist/",
    "assets/",
    "scripts/"
  ]
}
