{
  "name": "loongsuite-pilot",
  "version": "2.0.0",
  "type": "module",
  "description": "Multi-agent AI coding data collection platform",
  "keywords": [
    "ai-coding",
    "coding-agent",
    "claude-code",
    "codex",
    "cursor",
    "opentelemetry",
    "observability",
    "telemetry",
    "token-usage",
    "cost-tracking",
    "llm",
    "cli"
  ],
  "homepage": "https://github.com/alibaba/loongsuite-pilot#readme",
  "bugs": {
    "url": "https://github.com/alibaba/loongsuite-pilot/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alibaba/loongsuite-pilot.git"
  },
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "loongsuite-pilot": "dist/index.js"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "node dist/index.js",
    "perf:cursor-hook": "node tests/performance/cursor-hook-processor.perf.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:host:shortcut": "vitest run tests/unit/scripts/dashboard-shortcut.test.mjs",
    "test:host:openclaw": "vitest run tests/unit/hooks/openclaw/first-token.test.mjs tests/unit/hooks/openclaw/runtime-version.test.mjs tests/unit/hooks/openclaw/legacy-utils.test.mjs tests/unit/hooks/openclaw/interceptor.test.mjs",
    "test:host:openclaw-native": "vitest run tests/host/openclaw-native-interceptor.test.mjs tests/unit/hooks/openclaw/interceptor.test.mjs",
    "test:host:claude-fetch": "vitest run tests/unit/hooks/claude-code/fetch-intercept.test.mjs",
    "test:host:mimo": "vitest run --config vitest.host-plugins.config.ts tests/unit/hooks/mimo-code/plugin-replay.test.mjs tests/unit/hooks/mimo-code/resource-context.test.mjs",
    "test:host:pi": "vitest run --config vitest.host-plugins.config.ts tests/unit/hooks/pi-coding-agent-extension.test.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bash scripts/e2e/run-e2e.sh",
    "test:e2e:down": "docker compose -f tests/e2e-docker/docker-compose.l1.yml down -v",
    "test:e2e:l1": "docker compose -f tests/e2e-docker/docker-compose.l1.yml up --build --exit-code-from e2e-agent",
    "test:e2e:l2": "docker compose -f tests/e2e-docker/docker-compose.yml up --build --exit-code-from e2e-agent",
    "test:e2e:l2:down": "docker compose -f tests/e2e-docker/docker-compose.yml down -v",
    "test:e2e:l2:remote": "node scripts/e2e/run-remote-e2e.mjs",
    "test:e2e:docker": "npm run test:e2e:l2",
    "test:e2e:docker:down": "npm run test:e2e:l2:down",
    "test:e2e:remote": "npm run test:e2e:l2:remote",
    "postinstall": "node scripts/postinstall.js",
    "test:host:hermes": "vitest run tests/unit/hooks/hermes-agent-plugin.test.mjs tests/unit/hooks/hermes-agent-realtime.test.mjs tests/unit/hooks/hermes-agent-ttft.test.mjs tests/unit/hooks/hermes-subagent.test.mjs tests/unit/hooks/hermes-delayed-input.test.mjs",
    "test:host:opencode": "vitest run tests/unit/hooks/opencode-plugin-cwd.test.mjs tests/unit/hooks/opencode-plugin-session.test.mjs tests/unit/hooks/opencode-plugin-tokens.test.mjs tests/unit/hooks/opencode-plugin-v2.test.mjs",
    "test:host:jsonl-builder": "vitest run tests/host/jsonl-validation-builder.test.mjs",
    "test:host:trace-rules": "vitest run tests/host/trace-rule-generator.test.mjs",
    "test:host:e2e-tools": "vitest run tests/e2e-remote/agent-matrix.test.mjs tests/e2e-remote/agent-probe-body.test.mjs tests/e2e-remote/e2e-scenarios-l1-helpers.test.mjs tests/e2e-remote/expand-features.test.mjs tests/e2e-remote/l1-env.test.mjs tests/e2e-remote/mock-server.test.mjs tests/e2e-remote/propagate-sls-install.test.mjs tests/e2e-remote/qoder-pat.test.mjs tests/e2e-remote/remote-agent-config.test.mjs tests/e2e-remote/version-matrix.test.mjs"
  },
  "dependencies": {
    "@alicloud/log": "^1.2.6",
    "@loongsuite/otel-util-genai": "^0.1.0-beta.13",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.57.0",
    "@opentelemetry/otlp-transformer": "^0.57.0",
    "@opentelemetry/resources": "^1.30.0",
    "@opentelemetry/sdk-trace-base": "^1.30.0",
    "axios": "^1.20.0",
    "express": "^4.18.0",
    "jsonc-parser": "^3.3.1",
    "pino": "^9.14.0",
    "pino-roll": "^3.1.0",
    "smol-toml": "^1.9.1",
    "undici": "^6.29.1",
    "sqlite3": "file:compat/sqlite3"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/node": "^18.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "esbuild": "^0.28.0",
    "typescript": "^5.3.0",
    "vitest": "^1.6.1"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.60.2"
  },
  "files": [
    "dist/",
    "assets/",
    "compat/",
    "scripts/",
    "agents.d/"
  ],
  "overrides": {
    "cookie": "1.0.0",
    "tar": "^7.5.16",
    "https-proxy-agent": "^7.0.6",
    "axios": "^1.20.0",
    "body-parser": "1.20.9",
    "follow-redirects": "1.16.2",
    "form-data": "4.0.6",
    "protobufjs": "7.6.6",
    "proxy-addr": "2.0.8",
    "qs": "6.16.1"
  }
}
