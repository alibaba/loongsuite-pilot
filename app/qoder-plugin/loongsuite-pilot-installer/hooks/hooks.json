{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "async": true,
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "bash \"${QODER_PLUGIN_ROOT}\"/scripts/ensure-pilot.sh",
            "timeout": 900
          },
          {
            "type": "command",
            "shell": "powershell",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${QODER_PLUGIN_ROOT}/scripts/ensure-pilot.ps1\"",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
